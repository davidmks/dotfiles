#!/usr/bin/env bash
# tmux-resurrect runs this in each restored Claude pane. It reopens the pane's own
# conversation, or the folder's most recent one when the pane has no ID saved.
set -euo pipefail

resurrect_dir="$(tmux show-options -gqv @resurrect-dir)"
resurrect_dir="${resurrect_dir/#\~/$HOME}"
sessions_file="$resurrect_dir/claude_sessions"

pane_key="$(tmux display-message -p -t "${TMUX_PANE:?run this inside tmux}" "#{session_name}	#{window_index}	#{pane_index}")"
session_id=""
if [[ -f "$sessions_file" ]]; then
	session_id="$(awk -F '\t' -v key="$pane_key" '$1 "\t" $2 "\t" $3 == key { print $4 }' "$sessions_file")"
fi

if [[ -n "$session_id" ]]; then
	# The hook has no SessionStart event, so set the ID here for saves before the first message.
	tmux set-option -p -t "$TMUX_PANE" @claude_session_id "$session_id"
	exec claude --resume "$session_id"
fi
exec claude --continue
