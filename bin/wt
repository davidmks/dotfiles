#!/usr/bin/env bash
# wt <ticket-url-or-id> [-b base] [-n]
# Start or resume a ticket: worktree, tmux session, Claude reading it. -n skips attaching.

set -euo pipefail

die() {
	printf 'wt: %s\n' "$*" >&2
	exit 1
}

[ $# -ge 1 ] || die "usage: wt <ticket-url-or-id> [-b base]"
ticket=$1
shift

base=""
# Nothing to attach to without a terminal, so an agent running this stays put.
[ -t 1 ] && attach=1 || attach=0
while [ $# -gt 0 ]; do
	case $1 in
	-b | --base)
		[ $# -ge 2 ] || die "-b needs a branch name"
		base=$2
		shift 2
		;;
	--no-attach)
		attach=0
		shift
		;;
	*) die "unexpected argument: $1" ;;
	esac
done

command -v jq >/dev/null || die "jq is required"

id=$(printf '%s' "$ticket" | grep -oE '[A-Z]+-[0-9]+' | head -1 || true)

enter_session() {
	if [ -n "${TMUX:-}" ]; then
		tmux switch-client -t "$1"
	else
		tmux attach -t "$1"
	fi
}

# The first sarj config that defines windows wins outright, and without
# {{.Args}} the ticket reaches Claude nowhere and nothing reports it.
require_args_placeholder() {
	local main config
	main=$(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print substr($0, 10); exit}')
	[ -n "$main" ] || return 0
	for config in "$main/.sarj.local.toml" "$main/.sarj.toml" \
		"${XDG_CONFIG_HOME:-$HOME/.config}/sarj/config.toml"; do
		[ -f "$config" ] || continue
		grep -qF '[[tmux.windows]]' "$config" || continue
		if grep -qF '{{.Args}}' "$config"; then
			return 0
		fi
		die "$config defines tmux windows but no {{.Args}}, so the ticket would never reach Claude. Add {{.Args}} to its claude window command."
	done
	return 0
}

# Match on the id, not the name: the planning session renames the branch.
if [ -n "$id" ]; then
	found=$(sarj list -o json | jq -r --arg id "$id" '
		map(select(((.branch // "") + " " + (.name // "")) | contains($id)))
		| first
		| select(. != null)
		| [.branch, (.tmux.session // ""), ((.tmux.active // false) | tostring)]
		| @tsv
	')
	if [ -n "$found" ]; then
		IFS=$'\t' read -r branch session active <<<"$found"
		if [ "$active" = true ]; then
			if [ "$attach" = 1 ]; then
				enter_session "$session"
			else
				printf 'wt: %s already running in session %s\n' "$id" "$session"
			fi
		elif [ "$attach" = 1 ]; then
			sarj create "$branch" --reuse-existing
		else
			sarj create "$branch" --reuse-existing --no-attach
		fi
		exit 0
	fi
fi

require_args_placeholder

set --
if [ -n "$id" ]; then set -- "$id"; fi
if [ -n "$base" ]; then set -- "$@" --base "$base"; fi
if [ "$attach" = 0 ]; then set -- "$@" --no-attach; fi
sarj create "$@" --args "/start-ticket $ticket"
